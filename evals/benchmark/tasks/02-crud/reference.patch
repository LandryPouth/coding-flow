--- /dev/null
+++ b/spec/vendors.spec.js
@@ -0,0 +1,39 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert');
+const { createStore } = require('../src/store');
+const { createVendor, updateVendor, listVendors } = require('../src/vendors');
+
+test('a vendor is created with a name and a country', () => {
+  const store = createStore();
+  const vendor = createVendor(store, { name: 'Trainline', country: 'FR' });
+
+  assert.equal(vendor.name, 'Trainline');
+  assert.equal(listVendors(store).length, 1);
+});
+
+test('a blank name, a missing country and an unknown field are refused', () => {
+  const store = createStore();
+
+  assert.throws(() => createVendor(store, { name: '', country: 'FR' }), /missing field: name/);
+  assert.throws(() => createVendor(store, { name: 'X' }), /missing field: country/);
+});
+
+test('names are unique, on create and on edit', () => {
+  const store = createStore();
+  createVendor(store, { name: 'Trainline', country: 'FR' });
+  const other = createVendor(store, { name: 'Eurostar', country: 'BE' });
+
+  assert.throws(() => createVendor(store, { name: 'Trainline', country: 'BE' }), /already exists/);
+  assert.throws(() => updateVendor(store, other.id, { name: 'Trainline' }), /already exists/);
+});
+
+test('a vendor keeps its identity when edited', () => {
+  const store = createStore();
+  const vendor = createVendor(store, { name: 'Trainline', country: 'FR' });
+  const updated = updateVendor(store, vendor.id, { country: 'BE' });
+
+  assert.equal(updated.id, vendor.id);
+  assert.equal(listVendors(store).length, 1);
+});
