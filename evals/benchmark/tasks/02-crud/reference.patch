diff --git a/src/vendors.js b/src/vendors.js
new file mode 100644
index 0000000..9c9bde0
--- /dev/null
+++ b/src/vendors.js
@@ -0,0 +1,54 @@
+'use strict';
+
+const { requireFields, rejectUnknownFields } = require('./validate');
+
+const FIELDS = ['name', 'country'];
+
+function createVendor(store, payload) {
+  const fields = { name: payload.name, country: payload.country };
+
+  rejectUnknownFields(fields, FIELDS);
+  requireFields(fields, FIELDS);
+
+  if (store.all().some((vendor) => vendor.name === fields.name)) {
+    throw new Error(`vendor already exists: ${fields.name}`);
+  }
+
+  return store.insert({ name: String(fields.name), country: String(fields.country) });
+}
+
+function updateVendor(store, id, payload) {
+  const vendor = store.get(id);
+
+  if (!vendor) {
+    throw new Error(`no such vendor: ${id}`);
+  }
+
+  const changes = {};
+
+  if (payload.name !== undefined) {
+    if (payload.name === '') {
+      throw new Error('missing field: name');
+    }
+
+    if (store.all().some((other) => other.id !== id && other.name === payload.name)) {
+      throw new Error(`vendor already exists: ${payload.name}`);
+    }
+
+    changes.name = String(payload.name);
+  }
+
+  if (payload.country !== undefined) {
+    if (payload.country === '') {
+      throw new Error('missing field: country');
+    }
+
+    changes.country = String(payload.country);
+  }
+
+  return store.update(id, changes);
+}
+
+const listVendors = (store) => store.all();
+
+module.exports = { createVendor, updateVendor, listVendors };
