diff --git a/src/actor.js b/src/actor.js
new file mode 100644
index 0000000..9b8c9d2
--- /dev/null
+++ b/src/actor.js
@@ -0,0 +1,21 @@
+'use strict';
+
+const { getUser } = require('./users');
+
+// The one place an actor is resolved. Callers get a user or an error; they never
+// repeat the two checks.
+function resolveActor(actorId) {
+  const actor = getUser(actorId);
+
+  if (!actor) {
+    throw new Error(`unknown actor: ${actorId}`);
+  }
+
+  if (!actor.role) {
+    throw new Error(`actor has no role: ${actorId}`);
+  }
+
+  return actor;
+}
+
+module.exports = { resolveActor };
