diff --git a/src/vendors.js b/src/vendors.js
new file mode 100644
index 0000000..a294b9e
--- /dev/null
+++ b/src/vendors.js
@@ -0,0 +1,65 @@
+'use strict';
+
+const { requireFields, rejectUnknownFields } = require('./validate');
+
+const FIELDS = ['name', 'country'];
+
+function clean(field, value) {
+  const text = String(value).trim();
+
+  if (text === '') {
+    throw new Error(`missing field: ${field}`);
+  }
+
+  return text;
+}
+
+function assertNameFree(store, name, exceptId) {
+  const taken = store
+    .all()
+    .some((vendor) => vendor.id !== exceptId && vendor.name.toLowerCase() === name.toLowerCase());
+
+  if (taken) {
+    throw new Error(`vendor already exists: ${name}`);
+  }
+}
+
+// Vendors must live in their own store: expenses, approvals and the report
+// all treat every record in theirs as an expense.
+function createVendor(store, payload) {
+  rejectUnknownFields(payload, FIELDS);
+  requireFields(payload, FIELDS);
+
+  const name = clean('name', payload.name);
+  const country = clean('country', payload.country);
+  assertNameFree(store, name);
+
+  return store.insert({ name, country });
+}
+
+function updateVendor(store, id, payload) {
+  const vendor = store.get(id);
+
+  if (!vendor) {
+    throw new Error(`no such vendor: ${id}`);
+  }
+
+  rejectUnknownFields(payload, ['id', ...FIELDS]);
+
+  const changes = {};
+
+  if (payload.name !== undefined) {
+    changes.name = clean('name', payload.name);
+    assertNameFree(store, changes.name, id);
+  }
+
+  if (payload.country !== undefined) changes.country = clean('country', payload.country);
+
+  return store.update(id, changes);
+}
+
+function listVendors(store) {
+  return store.all();
+}
+
+module.exports = { createVendor, updateVendor, listVendors };
