--- /dev/null
+++ b/spec/vendors.spec.js
@@ -0,0 +1,84 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert');
+const { createStore } = require('../src/store');
+const { createReporter } = require('../src/report');
+const { createRouter } = require('../src/routes');
+const { createVendor, updateVendor, listVendors } = require('../src/vendors');
+
+const VALID = { name: 'Acme Rail', country: 'FR' };
+
+test('a vendor is created with a name and a country', () => {
+  const store = createStore();
+  const vendor = createVendor(store, VALID);
+
+  assert.equal(vendor.name, 'Acme Rail');
+  assert.equal(vendor.country, 'FR');
+  assert.deepEqual(listVendors(store), [vendor]);
+});
+
+test('a blank name or a missing country is refused', () => {
+  const store = createStore();
+
+  assert.throws(() => createVendor(store, { ...VALID, name: '' }), /missing field: name/);
+  assert.throws(() => createVendor(store, { ...VALID, name: '   ' }), /missing field: name/);
+  assert.throws(() => createVendor(store, { name: 'X' }), /missing field: country/);
+  assert.throws(() => createVendor(store, { ...VALID, country: ' ' }), /missing field: country/);
+  assert.throws(() => createVendor(store, { ...VALID, vat: '20' }), /unknown field: vat/);
+  assert.equal(listVendors(store).length, 0);
+});
+
+test('two vendors cannot share a name, whatever the case or padding', () => {
+  const store = createStore();
+  createVendor(store, VALID);
+
+  assert.throws(() => createVendor(store, { name: ' acme rail ', country: 'DE' }), /already exists/);
+  assert.equal(listVendors(store).length, 1);
+});
+
+test('a vendor can be edited, and keep its own name', () => {
+  const store = createStore();
+  const vendor = createVendor(store, VALID);
+
+  assert.equal(updateVendor(store, vendor.id, { country: 'BE' }).country, 'BE');
+  assert.equal(updateVendor(store, vendor.id, { name: 'ACME Rail' }).name, 'ACME Rail');
+});
+
+test('an edit cannot blank a field or take another vendor\'s name', () => {
+  const store = createStore();
+  const first = createVendor(store, VALID);
+  createVendor(store, { name: 'Bolt Hotels', country: 'ES' });
+
+  assert.throws(() => updateVendor(store, first.id, { name: '' }), /missing field: name/);
+  assert.throws(() => updateVendor(store, first.id, { country: '' }), /missing field: country/);
+  assert.throws(() => updateVendor(store, first.id, { name: 'bolt hotels' }), /already exists/);
+  assert.throws(() => updateVendor(store, 'nope', { country: 'BE' }), /no such vendor/);
+  assert.equal(store.get(first.id).name, 'Acme Rail');
+});
+
+test('the router lists, creates and edits vendors, refusing bad ones with 400', () => {
+  const store = createStore();
+  const router = createRouter(store, createReporter(store));
+
+  const created = router['POST /vendors'](VALID);
+  assert.equal(created.status, 200);
+
+  assert.equal(router['POST /vendors'](VALID).status, 400);
+  assert.equal(router['POST /vendors']({ name: '', country: 'FR' }).status, 400);
+
+  const edited = router['PATCH /vendors']({ id: created.body.id, country: 'BE' });
+  assert.equal(edited.body.country, 'BE');
+
+  assert.deepEqual(router['GET /vendors']({}).body.map((v) => v.name), ['Acme Rail']);
+});
+
+test('vendors never leak into expenses or the report', () => {
+  const store = createStore();
+  const router = createRouter(store, createReporter(store));
+
+  router['POST /vendors'](VALID);
+
+  assert.deepEqual(router['GET /expenses']({}).body, []);
+  assert.deepEqual(router['GET /report']({}).body, {});
+});
