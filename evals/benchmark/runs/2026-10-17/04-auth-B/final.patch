+
+test('an owner cannot approve their own expense', () => {
+  const { store, expense } = filed();
+
+  assert.throws(() => approveExpense(store, { actorId: 'alice', expenseId: expense.id }), /own expense/);
+  assert.equal(store.get(expense.id).status, 'submitted');
