+  assert.equal(store.get(expense.id).decidedBy, undefined);
+});
+
+test('a manager approves 50000 cents', () => {
+  const { store, expense } = filed({ amount: '500.00' });
+  const decided = approveExpense(store, { actorId: 'clara', expenseId: expense.id });
+
+  assert.equal(decided.status, 'approved');
