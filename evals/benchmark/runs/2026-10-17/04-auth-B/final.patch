+test('a decided large expense still reports its status to an under-privileged actor', () => {
+  const { store, expense } = filed({ amount: '900.00' });
+  approveExpense(store, { actorId: 'clara', expenseId: expense.id });
+
+  assert.throws(() => approveExpense(store, { actorId: 'bruno', expenseId: expense.id }), /cannot approve a approved/);
+});
