+});
+
+test('a manager approves a large expense', () => {
+  const { store, expense } = filed({ amount: '5000.00' });
+
+  assert.equal(approveExpense(store, { actorId: 'dinah', expenseId: expense.id }).decidedBy, 'dinah');
+});
+
+test('a refused expense can still be approved by a permitted actor', () => {
+  const { store, expense } = filed({ amount: '900.00' });
+
+  assert.throws(() => approveExpense(store, { actorId: 'bruno', expenseId: expense.id }), /manager/);
+  assert.equal(approveExpense(store, { actorId: 'clara', expenseId: expense.id }).status, 'approved');
+});
+
+test('unknown and missing inputs are not masked by the new rules', () => {
+  const { store, expense } = filed({ amount: '900.00' });
+
+  assert.throws(() => approveExpense(store, { actorId: 'nobody', expenseId: expense.id }), /unknown actor/);
+  assert.throws(() => approveExpense(store, { actorId: 'clara', expenseId: 'missing' }), /no such expense/);
+});
+
+test('the router refuses an unauthorized approval', () => {
+  const { store, expense } = filed({ amount: '900.00' });
+  const router = createRouter(store, { invalidate() {} });
