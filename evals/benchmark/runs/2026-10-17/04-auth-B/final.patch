+
+test('a manager cannot approve their own expense', () => {
+  const { store, expense } = filed({ actorId: 'clara', amount: '900.00' });
+
+  assert.throws(() => approveExpense(store, { actorId: 'clara', expenseId: expense.id }), /own expense/);
+  assert.equal(store.get(expense.id).status, 'submitted');
+});
+
+test('an employee cannot approve 50000 cents', () => {
+  const { store, expense } = filed({ amount: '500.00' });
+
+  assert.throws(() => approveExpense(store, { actorId: 'bruno', expenseId: expense.id }), /manager/);
