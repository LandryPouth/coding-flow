 });
+
+test('an unknown actor rejects nothing', () => {
+  const { store, expense } = filed();
+  assert.throws(() => rejectExpense(store, { actorId: 'nobody', expenseId: expense.id }), /unknown actor: nobody/);
+});
+
+test('a known actor with no role cannot approve', () => {
+  const { USERS } = require('../src/users');
+  USERS.ghost = { id: 'ghost', name: 'Ghost' };
+
+  try {
+    const { store, expense } = filed();
+    assert.throws(() => approveExpense(store, { actorId: 'ghost', expenseId: expense.id }), /actor has no role: ghost/);
+  } finally {
+    delete USERS.ghost;
+  }
+});
+
+test('a known actor with no role can still reject (unchanged behaviour)', () => {
+  const { USERS } = require('../src/users');
+  USERS.ghost = { id: 'ghost', name: 'Ghost' };
+
+  try {
+    const { store, expense } = filed();
+    const decided = rejectExpense(store, { actorId: 'ghost', expenseId: expense.id, reason: 'nope' });
+    assert.equal(decided.status, 'rejected');
+  } finally {
+    delete USERS.ghost;
+  }
+});
