diff --git a/spec/routes.spec.js b/spec/routes.spec.js
new file mode 100644
index 0000000..6165f9a
--- /dev/null
+++ b/spec/routes.spec.js
@@ -0,0 +1,39 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert');
+const { createStore } = require('../src/store');
+const { createRouter } = require('../src/routes');
+const { USERS } = require('../src/users');
+
+const VALID = {
+  actorId: 'alice',
+  description: 'Train to the client site',
+  amount: '84.50',
+  category: 'travel',
+  spentOn: '2026-03-02',
+};
+
+function router() {
+  return createRouter(createStore(), { invalidate() {}, totalsByCategory() { return {}; } });
+}
+
+test('POST /expenses answers 400 for an unknown actor', () => {
+  const res = router()['POST /expenses']({ ...VALID, actorId: 'nobody' });
+  assert.deepEqual(res, { status: 400, body: { error: 'unknown actor: nobody' } });
+});
+
+test('POST /expenses answers 400 for an actor with no role', () => {
+  USERS.ghost = { id: 'ghost', name: 'Ghost' };
+
+  try {
+    const res = router()['POST /expenses']({ ...VALID, actorId: 'ghost' });
+    assert.deepEqual(res, { status: 400, body: { error: 'actor has no role: ghost' } });
+  } finally {
+    delete USERS.ghost;
+  }
+});
+
+test('POST /expenses answers 200 for a valid actor', () => {
+  assert.equal(router()['POST /expenses'](VALID).status, 200);
+});
diff --git a/spec/users.spec.js b/spec/users.spec.js
new file mode 100644
index 0000000..caa8662
--- /dev/null
+++ b/spec/users.spec.js
@@ -0,0 +1,38 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert');
+const { USERS, requireActor, requireActorWithRole } = require('../src/users');
+
+test('requireActor returns a known actor', () => {
+  assert.equal(requireActor('alice'), USERS.alice);
+});
+
+test('requireActor refuses an unknown actor', () => {
+  assert.throws(() => requireActor('nobody'), /^Error: unknown actor: nobody$/);
+});
+
+test('requireActor accepts an actor with no role', () => {
+  USERS.ghost = { id: 'ghost', name: 'Ghost' };
+
+  try {
+    assert.equal(requireActor('ghost').id, 'ghost');
+  } finally {
+    delete USERS.ghost;
+  }
+});
+
+test('requireActorWithRole returns an actor that has a role', () => {
+  assert.equal(requireActorWithRole('clara'), USERS.clara);
+});
+
+test('requireActorWithRole refuses unknown and role-less actors', () => {
+  USERS.ghost = { id: 'ghost', name: 'Ghost' };
+
+  try {
+    assert.throws(() => requireActorWithRole('nobody'), /^Error: unknown actor: nobody$/);
+    assert.throws(() => requireActorWithRole('ghost'), /^Error: actor has no role: ghost$/);
+  } finally {
+    delete USERS.ghost;
+  }
+});
