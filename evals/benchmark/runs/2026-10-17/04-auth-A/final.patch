diff --git a/spec/approvals.spec.js b/spec/approvals.spec.js
index b4acf33..06e1b0d 100644
--- a/spec/approvals.spec.js
+++ b/spec/approvals.spec.js
@@ -47,3 +47,31 @@ test('an unknown actor decides nothing', () => {
   const { store, expense } = filed();
   assert.throws(() => approveExpense(store, { actorId: 'nobody', expenseId: expense.id }), /unknown actor/);
 });
+
+function filedBy(actorId, amount) {
+  const store = createStore();
+  return { store, expense: createExpense(store, { ...VALID, actorId, amount }) };
+}
+
+test('nobody approves their own expense, even a manager', () => {
+  const { store, expense } = filedBy('clara', '10.00');
+  assert.throws(() => approveExpense(store, { actorId: 'clara', expenseId: expense.id }), /your own/);
+  assert.equal(store.get(expense.id).status, 'submitted');
+});
+
+test('an employee approves a colleague expense below $500.00', () => {
+  const { store, expense } = filedBy('alice', '499.99');
+  assert.equal(approveExpense(store, { actorId: 'bruno', expenseId: expense.id }).status, 'approved');
+});
+
+test('$500.00 or more needs a manager', () => {
+  const { store, expense } = filedBy('alice', '500.00');
+  assert.throws(() => approveExpense(store, { actorId: 'bruno', expenseId: expense.id }), /manager/);
+  assert.equal(approveExpense(store, { actorId: 'clara', expenseId: expense.id }).decidedBy, 'clara');
+});
+
+test('a raised amount is checked at approval time', () => {
+  const { store, expense } = filedBy('alice', '100.00');
+  store.update(expense.id, { amountCents: 90000 });
+  assert.throws(() => approveExpense(store, { actorId: 'bruno', expenseId: expense.id }), /manager/);
+});
