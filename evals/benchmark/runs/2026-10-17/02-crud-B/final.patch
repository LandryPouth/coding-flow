new file mode 100644
index 0000000..d699aab
--- /dev/null
+++ b/src/vendors.js
@@ -0,0 +1,65 @@
+'use strict';
+
+const { rejectUnknownFields } = require('./validate');
+
+const FIELDS = ['actorId', 'name', 'country'];
+
+// requireFields lets "   " through, so vendor text fields are trimmed here.
+function cleanText(payload, field) {
+  const value = payload[field];
+
+  if (value === undefined || value === null || String(value).trim() === '') {
+    throw new Error(`missing field: ${field}`);
+  }
+
+  return String(value).trim();
+}
+
+function sameName(a, b) {
+  return a.toLowerCase() === b.toLowerCase();
+}
+
+function assertNameFree(store, name, exceptId) {
+  const taken = store.all().some((vendor) => vendor.id !== exceptId && sameName(vendor.name, name));
+
+  if (taken) {
+    throw new Error('duplicate vendor name');
+  }
+}
+
+function createVendor(store, payload) {
+  rejectUnknownFields(payload, FIELDS);
+
+  const name = cleanText(payload, 'name');
+  const country = cleanText(payload, 'country');
+  assertNameFree(store, name);
+
+  return store.insert({ name, country });
+}
+
+function updateVendor(store, id, payload) {
+  const vendor = store.get(id);
+
+  if (!vendor) {
+    throw new Error(`no such vendor: ${id}`);
+  }
+
+  rejectUnknownFields(payload, ['id', ...FIELDS]);
+
+  const changes = {};
+
+  if (payload.name !== undefined) {
+    changes.name = cleanText(payload, 'name');
+    assertNameFree(store, changes.name, id);
+  }
+
+  if (payload.country !== undefined) changes.country = cleanText(payload, 'country');
+
+  return store.update(id, changes);
+}
+
+function listVendors(store) {
+  return store.all();
+}
+
+module.exports = { createVendor, updateVendor, listVendors };
