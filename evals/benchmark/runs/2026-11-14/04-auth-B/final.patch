diff --git a/spec/approvals.spec.js b/spec/approvals.spec.js
index b4acf33..f5d5ff5 100644
--- a/spec/approvals.spec.js
+++ b/spec/approvals.spec.js
@@ -47,3 +47,74 @@ test('an unknown actor decides nothing', () => {
   const { store, expense } = filed();
   assert.throws(() => approveExpense(store, { actorId: 'nobody', expenseId: expense.id }), /unknown actor/);
 });
+
+function filedBy(actorId, amount) {
+  const store = createStore();
+  return { store, expense: createExpense(store, { ...VALID, actorId, amount }) };
+}
+
+function assertUndecided(expense) {
+  assert.equal(expense.status, 'submitted');
+  assert.equal(expense.decidedBy, undefined);
+}
+
+test('nobody approves their own expense', () => {
+  const { store, expense } = filedBy('alice', '62.00');
+
+  assert.throws(() => approveExpense(store, { actorId: 'alice', expenseId: expense.id }), /own expense/);
+  assertUndecided(store.get(expense.id));
+});
+
+test('a manager cannot approve their own expense', () => {
+  const { store, expense } = filedBy('clara', '900.00');
+
+  assert.throws(() => approveExpense(store, { actorId: 'clara', expenseId: expense.id }), /own expense/);
+  assertUndecided(store.get(expense.id));
+});
+
+test('an employee cannot approve $500.00 or more', () => {
+  const { store, expense } = filedBy('alice', '900.00');
+
+  assert.throws(() => approveExpense(store, { actorId: 'bruno', expenseId: expense.id }), /manager/);
+  assertUndecided(store.get(expense.id));
+});
+
+test('the manager threshold is inclusive at $500.00', () => {
+  const { store, expense } = filedBy('alice', '500.00');
+
+  assert.throws(() => approveExpense(store, { actorId: 'bruno', expenseId: expense.id }), /manager/);
+  assertUndecided(store.get(expense.id));
+
+  const decided = approveExpense(store, { actorId: 'clara', expenseId: expense.id });
+  assert.equal(decided.status, 'approved');
+  assert.equal(decided.decidedBy, 'clara');
+});
+
+test('an employee is refused one cent above the threshold too', () => {
+  const { store, expense } = filedBy('alice', '500.01');
+
+  assert.throws(() => approveExpense(store, { actorId: 'bruno', expenseId: expense.id }), /manager/);
+});
+
+test('an employee approves just under $500.00', () => {
+  const { store, expense } = filedBy('alice', '499.99');
+  const decided = approveExpense(store, { actorId: 'bruno', expenseId: expense.id });
+
+  assert.equal(decided.status, 'approved');
+  assert.equal(decided.decidedBy, 'bruno');
+});
+
+test('another manager approves a manager\'s large expense', () => {
+  const { store, expense } = filedBy('clara', '900.00');
+  const decided = approveExpense(store, { actorId: 'dinah', expenseId: expense.id });
+
+  assert.equal(decided.status, 'approved');
+  assert.equal(decided.decidedBy, 'dinah');
+});
+
+test('a decided expense keeps its "cannot approve" error before the approval rules', () => {
+  const { store, expense } = filedBy('alice', '900.00');
+  approveExpense(store, { actorId: 'clara', expenseId: expense.id });
+
+  assert.throws(() => approveExpense(store, { actorId: 'alice', expenseId: expense.id }), /cannot approve a approved/);
+});
diff --git a/spec/routes.spec.js b/spec/routes.spec.js
new file mode 100644
index 0000000..e3cb9a7
--- /dev/null
+++ b/spec/routes.spec.js
@@ -0,0 +1,39 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert');
+const { createStore } = require('../src/store');
+const { createReporter } = require('../src/report');
+const { createRouter } = require('../src/routes');
+
+function routerWithLargeExpense() {
+  const store = createStore();
+  const router = createRouter(store, createReporter(store));
+  const created = router['POST /expenses']({
+    actorId: 'alice',
+    description: 'Laptop',
+    amount: '900.00',
+    category: 'hardware',
+    spentOn: '2026-03-04',
+  });
+  return { store, router, expenseId: created.body.id };
+}
+
+test('POST /approvals refuses self-approval and non-manager over the threshold', () => {
+  const { store, router, expenseId } = routerWithLargeExpense();
+
+  const asEmployee = router['POST /approvals']({ actorId: 'bruno', expenseId });
+  assert.equal(asEmployee.status, 400);
+  assert.match(asEmployee.body.error, /manager/);
+
+  const asOwner = router['POST /approvals']({ actorId: 'alice', expenseId });
+  assert.equal(asOwner.status, 400);
+  assert.match(asOwner.body.error, /own expense/);
+
+  assert.equal(store.get(expenseId).status, 'submitted');
+  assert.equal(store.get(expenseId).decidedBy, undefined);
+
+  const asManager = router['POST /approvals']({ actorId: 'clara', expenseId });
+  assert.equal(asManager.status, 200);
+  assert.equal(asManager.body.decidedBy, 'clara');
+});
