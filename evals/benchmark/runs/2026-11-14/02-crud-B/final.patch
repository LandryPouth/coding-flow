diff --git a/src/vendors.js b/src/vendors.js
new file mode 100644
index 0000000..33c7506
--- /dev/null
+++ b/src/vendors.js
@@ -0,0 +1,69 @@
+'use strict';
+
+const { requireFields, rejectUnknownFields } = require('./validate');
+
+const FIELDS = ['name', 'country'];
+// actorId is accepted and ignored: vendor writes need no known actor.
+const CREATE_FIELDS = [...FIELDS, 'actorId'];
+const UPDATE_FIELDS = ['id', ...CREATE_FIELDS];
+
+// Trims the given vendor fields; rejects non-strings and blanks before anything is stored.
+function normalize(payload, fields) {
+  const values = {};
+
+  for (const field of fields) {
+    const value = payload[field];
+
+    if (value === undefined) continue;
+
+    if (typeof value !== 'string') {
+      throw new Error(`invalid field: ${field}`);
+    }
+
+    values[field] = value.trim();
+  }
+
+  requireFields(values, Object.keys(values));
+  return values;
+}
+
+function assertNameFree(vendorStore, name, exceptId) {
+  const key = name.toLowerCase();
+  const clash = vendorStore.all().find((vendor) => vendor.id !== exceptId && vendor.name.toLowerCase() === key);
+
+  if (clash) {
+    throw new Error(`duplicate vendor name: ${name}`);
+  }
+}
+
+function createVendor(vendorStore, payload) {
+  rejectUnknownFields(payload, CREATE_FIELDS);
+  const vendor = normalize(payload, FIELDS);
+  requireFields(vendor, FIELDS);
+  assertNameFree(vendorStore, vendor.name);
+
+  return vendorStore.insert(vendor);
+}
+
+function updateVendor(vendorStore, id, payload) {
+  const vendor = vendorStore.get(id);
+
+  if (!vendor) {
+    throw new Error(`no such vendor: ${id}`);
+  }
+
+  rejectUnknownFields(payload, UPDATE_FIELDS);
+  const changes = normalize(payload, FIELDS);
+
+  if (changes.name !== undefined) {
+    assertNameFree(vendorStore, changes.name, id);
+  }
+
+  return vendorStore.update(id, changes);
+}
+
+function listVendors(vendorStore) {
+  return vendorStore.all();
+}
+
+module.exports = { createVendor, updateVendor, listVendors };
