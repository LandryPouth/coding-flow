{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @landry_pouth/coding-flow@0.3.1 guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
