#!/usr/bin/env sh
# pre-push — runs the test suite before any push and blocks if it breaks.
#
# This hook is versioned (.githooks/ directory) so it can be shared with the team.
# It only becomes active once per clone, after:
#   git config core.hooksPath .githooks
#
# To push urgently without running the tests:
#   git push --no-verify

echo "→ pre-push: npm test"

if ! npm test; then
  echo "✗ Tests failing — push cancelled (use --no-verify to force)." >&2
  exit 1
fi

echo "✓ Tests OK — push allowed."
